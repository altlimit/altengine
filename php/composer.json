{
    "name": "altlimit/altengine",
    "description": "Official PHP SDK for altengine - managed datastore, search, and realtime channels",
    "type": "library",
    "license": "MIT",
    "keywords": ["altengine", "search", "datastore", "pubsub", "realtime"],
    "homepage": "https://www.altengine.net",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.5",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "AltEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AltEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
